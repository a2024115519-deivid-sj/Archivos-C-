#include <iostream>
#include <math.h>
using namespace std;

int main() {
    int n,i;
    bool flag=false;
    
    cout << "Escriba un número: ";
    cin >> n;
    
    for (i = 2; i <= sqrt(n); i++) {
        if (n % i == 0) {
            flag = true; // No es primo
            break;
        }
    }
      
        if (flag == true) {
            cout << "No es primo" << endl;
        } else {
            cout << "Es primo";  
          }
    
    
    return 0;
}
