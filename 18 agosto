#include <iostream>
#include <cmath>
using namespace std;

int main()
{

	float a,b,c;
	double x1,x2;

	cout<<"Ingrese el coeficiente de a: ";
	cin>>a;
	cout<<"Ingrese el coeficiente de b: ";
	cin>>b;
	cout<<"Ingrese el coeficiente de c: ";
	cin>>c;

	x1=(-b + sqrt(b*b-4*a*c))/(2*a);
	x2=(-b - sqrt(b*b-4*a*c))/(2*a);

	cout<<"El valor de la raíz x1 es: " << x1 <<endl;
	cout<<"El valor de la raíz x2 es: " << x2;
	
	    return 0;
}
